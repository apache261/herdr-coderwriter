{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/coderwriter.svg",
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 260 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "workspace-chrome" }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            { "id": "spaces", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "spaces" } },
            { "id": "agents", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "agents" } }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": { "px": 69 },
          "content": { "mod": "workspace-chrome", "props": { "footer": true } }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "cw-bar",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "coderwriter", "props": { "role": "bar", "controls": true } }
        },
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 40 },
          "content": { "mod": "coderwriter-tabs", "props": { "controls": false } }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "header": {
                    "content": { "mod": "coderwriter-pane" },
                    "height": 32,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 380 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "reviews",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "coderwriter-files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } },
                    { "id": "reviews", "type": "block", "content": { "mod": "coderwriter", "props": { "role": "reviews" } } },
                    { "id": "usage", "type": "block", "content": { "mod": "coderwriter", "props": { "role": "usage" } } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 28 },
          "content": { "mod": "workspace-status" }
        }
      ]
    }
  ]
}
